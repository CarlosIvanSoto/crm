{
	"name": "@travel/db",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./client": "./src/client.ts",
		"./tenancy": "./src/tenancy.ts",
		"./enums": "./src/generated/prisma/enums.ts",
		"./json": "./src/json.ts",
		"./folio": "./src/folio.ts",
		"./currency": "./src/currency.ts",
		"./fx": "./src/fx.ts",
		"./fields": "./src/fields.ts",
		"./fields-shape": "./src/fields-shape.ts"
	},
	"scripts": {
		"build": "prisma generate",
		"check-types": "tsc --noEmit",
		"travel:deploy": "prisma migrate deploy",
		"travel:generate": "prisma generate",
		"travel:migrate": "bun scripts/require-local-db.ts travel:migrate && prisma migrate dev",
		"travel:push": "bun scripts/require-local-db.ts travel:push && prisma db push",
		"travel:reset": "bun scripts/require-local-db.ts travel:reset && prisma migrate reset",
		"travel:seed": "bun scripts/require-local-db.ts travel:seed && prisma db seed",
		"travel:studio": "prisma studio",
		"travel:test": "bun scripts/test-db.ts",
		"test": "bun test",
		"dev:prepare": "bun scripts/prepare-dev.ts",
		"lint": "biome check .",
		"postinstall": "prisma generate",
		"clean": "rm -rf .turbo node_modules src/generated"
	},
	"dependencies": {
		"@crm/env": "workspace:*",
		"@prisma/adapter-pg": "^7.9.1",
		"@prisma/client": "^7.9.1"
	},
	"devDependencies": {
		"@crm/typescript-config": "workspace:*",
		"@types/node": "^24.10.1",
		"pg": "^8.22.0",
		"prisma": "^7.9.1",
		"typescript": "5.9.2"
	}
}
