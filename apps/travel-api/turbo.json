{
	"$schema": "https://turborepo.dev/schema.json",
	"extends": ["//"],
	"tasks": {
		"build": {
			"dependsOn": ["$TURBO_EXTENDS$"],
			"outputs": ["dist/**"]
		},
		"check-types": {
			"dependsOn": ["$TURBO_EXTENDS$", "trpc:generate"]
		},
		"trpc:generate": {
			"dependsOn": ["^build"],
			"inputs": ["src/**/*.ts"],
			"outputs": ["src/generated/**"]
		},
		"dev": {
			"dependsOn": ["$TURBO_EXTENDS$"],
			"cache": false,
			"persistent": true,
			"passThroughEnv": [
				"CACHE_TTL_MS",
				"REDIS_URL",
				"TRAVEL_API_URL",
				"TRAVEL_APP_URL",
				"TRAVEL_AUTH_COOKIE_DOMAIN",
				"TRAVEL_BETTER_AUTH_SECRET",
				"TRAVEL_BLOB_READ_WRITE_TOKEN",
				"TRAVEL_CRON_SECRET",
				"TRAVEL_DATABASE_URL",
				"TRAVEL_GOOGLE_CLIENT_ID",
				"TRAVEL_GOOGLE_CLIENT_SECRET",
				"TRAVEL_INVITATION_FROM",
				"TRAVEL_PORT",
				"TRAVEL_QUOTE_FROM",
				"TRAVEL_REMINDER_FROM",
				"TRAVEL_RESEND_API_KEY"
			]
		},
		"test": {
			"passThroughEnv": [
				"CACHE_TTL_MS",
				"REDIS_URL",
				"TEST_RUN_ID",
				"TRAVEL_API_URL",
				"TRAVEL_APP_URL",
				"TRAVEL_AUTH_COOKIE_DOMAIN",
				"TRAVEL_BETTER_AUTH_SECRET",
				"TRAVEL_BLOB_READ_WRITE_TOKEN",
				"TRAVEL_CRON_SECRET",
				"TRAVEL_DATABASE_URL",
				"TRAVEL_TEST_DATABASE_URL",
				"TRAVEL_GOOGLE_CLIENT_ID",
				"TRAVEL_GOOGLE_CLIENT_SECRET",
				"TRAVEL_INVITATION_FROM",
				"TRAVEL_PORT",
				"TRAVEL_QUOTE_FROM",
				"TRAVEL_REMINDER_FROM",
				"TRAVEL_RESEND_API_KEY"
			]
		}
	}
}
